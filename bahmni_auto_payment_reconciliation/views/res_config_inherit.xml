<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_bahmni_payments" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bahmni.payments</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Bahmni Payments" string="Bahmni Payments" name="bahmni_auto_payment_reconciliation">
                    <block title="Payment Configurations" id="bahmni_payment_configurations">
                        <setting id="is_auto_payment_allocation" help="When a payment is posted, enabling this config will automatically allocate any credit invoice and the payment to outstanding invoices.">
                            <field name="is_auto_payment_allocation_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>