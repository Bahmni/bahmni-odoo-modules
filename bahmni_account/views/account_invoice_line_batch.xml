<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<!-- Invoice line batch tracking (moved from bahmni_stock for proper layering) -->
	
	<record id="view_account_move_line_form_batch_bahmni" model="ir.ui.view">
		<field name="name">account.move.line.form.batch.bahmni</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='display_type']" position="after">
				<field name="lot_id" readonly="1"/>
				<field name="expiry_date" readonly="1"/>
			</xpath>
		</field>
	</record>
</odoo>

