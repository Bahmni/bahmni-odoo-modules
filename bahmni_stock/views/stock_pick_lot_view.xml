<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_stock_move_line_operation_list_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='lot_name']" position="before">
                <field name="existing_lot_id" string="Existing Lots" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}" invisible="not context.get('show_lots_text')"/>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">existing_lot_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="column_invisible">not parent.use_expiration_date or parent.picking_code != 'incoming'</attribute>
                <attribute name="readonly">picking_type_use_existing_lots or existing_lot_id</attribute>
            </xpath>
            <xpath expr="//list/field[@name='product_uom_id']" position="after">
                <field name="cost_price" invisible="not context.get('show_lots_text')"/>
                <field name="sale_price" invisible="not context.get('show_lots_text')"/>
                <field name="mrp" invisible="not context.get('show_lots_text')"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="is_move_line_lot_expiring_soon" invisible="1"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">False</attribute>
                <attribute name="decoration-warning">is_move_line_lot_expiring_soon and state != 'done'</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_list_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.list.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='quantity']" position="after">
                <field name="balance" readonly="1" force_save="1"/>
            </xpath>
            <xpath expr="//list/field[@name='location_id']" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code in ('incoming', 'internal')</attribute>
            </xpath>
            <xpath expr="//list/field[@name='location_dest_id']" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code in ('incoming', 'internal')</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="is_move_line_lot_expiring_soon" invisible="1"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">False</attribute>
                <attribute name="decoration-warning">is_move_line_lot_expiring_soon and state != 'done'</attribute>
            </xpath>
        </field>
    </record>

</odoo>