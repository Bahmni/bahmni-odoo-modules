<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Product-Stock integration views (moved from bahmni_product for proper layering) -->
    
    <record id="view_product_template_form_stock_bahmni" model="ir.ui.view">
        <field name="name">product.template.form.stock.bahmni</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                    name="action_open_quants"
                    attrs="{'invisible':[('type', '!=', 'product')]}"
                    class="oe_stat_button" icon="fa-building-o" context="{'show_actual_stock': 1}">
                    <field name="actual_stock" widget="statinfo" string="Actual Stock"/>
                </button>
            </xpath>
        </field>
    </record>
    
    <record id="view_stock_product_template_tree_bahmni" model="ir.ui.view">
        <field name="name">stock.product.template.tree.bahmni</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
        <field name="arch" type="xml">
            <field name="virtual_available" position="after">
                <field name="actual_stock"/>
            </field>
        </field>
    </record>
    
    <record id="view_stock_product_tree_bahmni" model="ir.ui.view">
        <field name="name">stock.product.tree.bahmni</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.view_stock_product_tree"/>
        <field name="arch" type="xml">
            <field name="virtual_available" position="after">
                <field name="actual_stock"/>
            </field>
        </field>
    </record>
    
    <record id="view_product_form_stock_bahmni" model="ir.ui.view">
        <field name="name">product.form.stock.bahmni</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                    name="action_open_quants"
                    attrs="{'invisible':[('type', '!=', 'product')]}"
                    class="oe_stat_button" icon="fa-building-o" context="{'show_actual_stock': 1}">
                    <field name="actual_stock" widget="statinfo" string="Actual Stock"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
